# Instagram Graph API — long-lived access token (60 days, must be refreshed)
# Used by src/components/sections/SocialFeed.tsx to show the real @tonito_quikle feed.
# Without this set, the site falls back to the static placeholder images.
INSTAGRAM_ACCESS_TOKEN=

# Meta app credentials, only needed to ISSUE/REFRESH the token above via
# /api/instagram (one-time login) and /api/instagram/refresh (every ~60 days).
# From the Meta App Dashboard > 앱 설정 > 기본 설정.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
